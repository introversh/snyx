{
  "name": "youtube-together-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@youtube-together/api\" \"npm run dev --workspace=@youtube-together/web\"",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run db:migrate --workspace=@youtube-together/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
