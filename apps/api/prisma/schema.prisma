datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Room {
  id                    String        @id
  name                  String?
  currentVideoId        String?
  currentVideoTitle     String?
  currentVideoThumbnail String?
  isPlaying             Boolean       @default(false)
  position              Float         @default(0.0)
  playbackStartedAt     DateTime?
  updatedAt             DateTime      @updatedAt
  createdAt             DateTime      @default(now())

  // Room lifecycle
  isPermanent           Boolean       @default(false)
  expiresAt             DateTime?

  // Relations
  queue                 QueueItem[]
  chatMessages          ChatMessage[]
  ipLogs                RoomIpLog[]
  videoHistory          RoomVideoHistory[]
  activityLogs          RoomActivityLog[]
  homeKnocks            HomeKnock[]

  // Home room owner (inverse of User.homeRoom)
  homeOwner             User?         @relation("UserHomeRoom")
}

model QueueItem {
  id           String   @id @default(uuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  videoId      String
  title        String
  thumbnail    String
  channelTitle String
  duration     Int?
  addedBy      String
  addedAt      DateTime @default(now())
  order        Int      @default(0)

  @@index([roomId, order])
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String
  displayName     String?
  profilePicture  String?
  bio             String?  @default("")
  profileBanner   String?  @default("")
  gender          String   @default("male")
  isPrivate       Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Session management
  activeToken      String?

  // Active status
  showActiveStatus Boolean  @default(true)
  isOnline         Boolean  @default(false)
  lastSeenAt       DateTime?

  // Home room
  homeRoomId       String?  @unique
  homeRoom         Room?    @relation("UserHomeRoom", fields: [homeRoomId], references: [id])

  // Existing relations
  sentFriendRequests     FriendRequest[] @relation("FriendRequestsSent")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestsReceived")

  friendships1 Friendship[] @relation("Friendships1")
  friendships2 Friendship[] @relation("Friendships2")

  sentDMs         DirectMessage[] @relation("DMSent")
  receivedDMs     DirectMessage[] @relation("DMReceived")

  sentInvites     RoomInvite[] @relation("InvitesSent")
  receivedInvites RoomInvite[] @relation("InvitesReceived")

  // New relations
  knocksSent       HomeKnock[]       @relation("KnocksSent")
  playlists        Playlist[]
  savedPlaylists   SavedPlaylist[]   @relation("UserSavedPlaylists")
  activityLogs     RoomActivityLog[]
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("FriendRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("FriendRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String
  user1     User     @relation("Friendships1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User     @relation("Friendships2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("DMSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("DMReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, createdAt])
}

model RoomInvite {
  id          String   @id @default(uuid())
  roomId      String
  senderId    String
  sender      User     @relation("InvitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("InvitesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([receiverId, createdAt])
}

model ChatMessage {
  id                String                @id @default(uuid())
  roomId            String
  room              Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId          String
  senderName        String
  senderAvatar      String?
  content           String
  replyToId         String?
  replyToSenderName String?
  replyToContent    String?
  isEdited          Boolean               @default(false)
  isDelivered       Boolean               @default(false)
  isRead            Boolean               @default(false)
  createdAt         DateTime              @default(now())
  reactions         ChatMessageReaction[]

  @@index([roomId, createdAt])
}

model ChatMessageReaction {
  id            String      @id @default(uuid())
  messageId     String
  message       ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participantId String
  displayName   String
  emoji         String
  createdAt     DateTime    @default(now())

  @@unique([messageId, participantId])
}

// ──────────────────────────────────────────────────
// NEW MODELS
// ──────────────────────────────────────────────────

model RoomIpLog {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ipAddress String
  userId    String?
  joinedAt  DateTime @default(now())

  @@index([roomId, joinedAt])
}

model RoomVideoHistory {
  id         String   @id @default(uuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  videoId    String
  sourceUrl  String
  title      String
  thumbnail  String
  playedAt   DateTime @default(now())
  playedById String?

  @@index([roomId, playedAt])
}

model RoomActivityLog {
  id              String    @id @default(uuid())
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationSeconds Int?

  @@index([roomId, userId])
}

model HomeKnock {
  id          String    @id @default(uuid())
  homeRoomId  String
  homeRoom    Room      @relation(fields: [homeRoomId], references: [id], onDelete: Cascade)
  knockerId   String
  knocker     User      @relation("KnocksSent", fields: [knockerId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING, ADMITTED, DISMISSED
  knockedAt   DateTime  @default(now())
  respondedAt DateTime?
  seenByOwner Boolean   @default(false)

  @@index([homeRoomId, knockedAt])
  @@index([knockerId])
}

model Playlist {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPrivate   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       PlaylistItem[]
  savedBy     SavedPlaylist[] @relation("PlaylistSavedBy")

  @@index([userId])
}

model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoId    String
  title      String
  thumbnail  String
  duration   Int?
  sourceUrl  String
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  @@index([playlistId, order])
}

model SavedPlaylist {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserSavedPlaylists", fields: [userId], references: [id], onDelete: Cascade)
  playlistId String
  playlist   Playlist @relation("PlaylistSavedBy", fields: [playlistId], references: [id], onDelete: Cascade)
  savedAt    DateTime @default(now())

  @@unique([userId, playlistId])
  @@index([userId])
}
